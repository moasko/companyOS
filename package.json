{
  "name": "companyos",
  "version": "0.1.0",
  "private": true,
  "description": "CompanyOS — l'OS web qui réunit les applications de gestion de l'entreprise",
  "license": "CC0-1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @companyos/web",
    "dev:web": "npm run dev --workspace @companyos/web",
    "dev:api": "npm run dev --workspace @companyos/api",
    "build": "npm run build --workspace @companyos/web",
    "preview": "npm run preview --workspace @companyos/web",
    "start": "npm run start --workspace @companyos/api",
    "exploitant": "npm run exploitant --workspace @companyos/api",
    "mcp": "npm run start --workspace @companyos/mcp",
    "mcp:login": "npm run login --workspace @companyos/mcp",
    "mcp:check": "npm run check --workspace @companyos/mcp",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspace @companyos/web",
    "db:migrate": "npm run prisma:migrate --workspace @companyos/api",
    "db:deploy": "npm run prisma:deploy --workspace @companyos/api",
    "db:studio": "npm run prisma:studio --workspace @companyos/api",
    "db:seed": "npm run seed --workspace @companyos/api",
    "audit:prod": "npm audit --omit=dev"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.2"
  }
}
