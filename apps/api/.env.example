# Configuration de l'API CompanyOS.
#
# Copiez ce fichier vers apps/api/.env et mettez-y les vraies valeurs.
# .env est gitignoré ; ce fichier-ci ne l'est pas — n'y mettez jamais de
# mot de passe réel.

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# PostgreSQL — en local via docker compose, ou une instance gérée
# (Neon, Supabase, RDS).
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/companyos?schema=public"

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Signature des jetons de session. À régénérer pour chaque environnement :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="changez-moi-en-production"
JWT_EXPIRES_IN="7d"

# Chiffrement des secrets rangés en base (clé secrète S3, mot de passe SMTP
# d'un espace). Distincte du secret JWT, et c'est le point : à défaut, faire
# tourner les sessions rendrait illisibles tous les secrets déjà stockés.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Absente, le secret JWT sert de repli — pratique en développement, à ne pas
# laisser ainsi en production.
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Réseau
# ---------------------------------------------------------------------------
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Nombre de reverse-proxies devant l'API, pour lire l'adresse réelle du
# client dans X-Forwarded-For.
#   0  aucun — l'API est jointe directement (développement)
#   1  un proxy devant (Traefik, nginx, Dokploy) — le cas normal en production
# Ne jamais mettre `true` : cela reviendrait à croire n'importe quel client
# qui envoie l'en-tête lui-même, donc à laisser maquiller l'adresse dans le
# journal d'audit et contourner la limitation de débit.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Stockage des fichiers
# ---------------------------------------------------------------------------
# Pilote : "local" (disque) ou "s3". La destination des nouveaux fichiers se
# règle aussi depuis la console Plateforme, qui a priorité sur cette valeur.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# Quota d'un nouvel espace, en octets. Vide = celui de la formule Découverte
# (src/formules.js) — à ne renseigner que pour une offre de lancement.
DEFAULT_TENANT_QUOTA=""

# Taille maximale d'un fichier importé, en octets (ici 128 Mo). Le pilote S3
# assemble l'objet en mémoire avant de l'envoyer : une valeur élevée permet
# à quelques imports simultanés d'épuiser la mémoire du processus.
UPLOAD_MAX_OCTETS=134217728

# ---------------------------------------------------------------------------
# Courrier sortant
# ---------------------------------------------------------------------------
# Relais SMTP — facultatif. Sans SMTP_HOST, aucun mail ne part et les
# invitations fonctionnent par code. N'importe quel relais convient : Brevo,
# Resend, Mailgun, un Gmail professionnel, ou votre propre postfix.
# Port 587 = STARTTLS (le plus courant) ; 465 = TLS implicite.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="CompanyOS <no-reply@companyos.fr>"

# Plafond d'envoi par espace de travail et par 24 h — tous chemins confondus
# (Courrier, campagnes, relances de factures). Il ne protège pas d'un
# attaquant patient : il borne le dégât le temps qu'on remarque l'anomalie,
# avant que l'IP d'envoi ne se retrouve sur liste noire et que plus aucun
# espace ne puisse envoyer ses factures.
MAIL_QUOTA_JOUR=500

# Adresse publique du shell, insérée dans les mails (défaut : CORS_ORIGIN).
PUBLIC_URL=""
# Adresse publique de l'API — les liens de désinscription pointent dessus.
PUBLIC_API_URL=""

# ---------------------------------------------------------------------------
# Exploitation
# ---------------------------------------------------------------------------
# Les adresses autorisées à ouvrir la console Plateforme : tous les espaces,
# changement de formule, configuration du stockage. Au-dessus des rôles
# d'espace — on ne devient pas exploitant en créant un espace.
PLATFORM_ADMINS="vous@companyos.fr"

# Développement uniquement : autorise un relais SMTP d'espace sur le réseau
# local (ex. un faux serveur sur localhost:2525). Ignoré en production.
# AUTORISER_RESEAU_PRIVE=true

# Sessions (cookie HttpOnly). Inactivité avant fermeture, en minutes.
# SESSION_INACTIVITE_MINUTES=720
# SameSite du cookie : Strict (shell et API sur le même site, ex.
# app.exemple.fr / api.exemple.fr) ; None si deux domaines différents.
# SESSION_SAMESITE=Strict
