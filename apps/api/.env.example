# PostgreSQL — en local via docker-compose, ou une instance gérée (Neon, Supabase, RDS).
# Copiez ce fichier vers server/.env et mettez-y les vraies valeurs.
# .env est gitignoré ; ce fichier-ci ne l'est pas — n'y mettez jamais de mot de passe.
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/companyos?schema=public"

# Secret de signature des JWT. À régénérer pour chaque environnement :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="changez-moi-en-production"
JWT_EXPIRES_IN="7d"

PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Pilote de stockage des fichiers : "local" (disque) ou "s3".
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# Quota offert à chaque nouvel espace de travail, en octets (ici 5 Go).
DEFAULT_TENANT_QUOTA=5368709120

# Relais SMTP sortant — facultatif. Sans SMTP_HOST, aucun mail ne part et
# les invitations fonctionnent par code. N'importe quel relais convient :
# Brevo, Resend, Mailgun, un Gmail professionnel, ou votre propre postfix.
# Port 587 = STARTTLS (le plus courant) ; 465 = TLS implicite.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="CompanyOS <no-reply@mondomaine.com>"
# Adresse publique du front, insérée dans les mails (défaut : CORS_ORIGIN).
PUBLIC_URL=""

# Les exploitants de la plateforme : les adresses autorisées à ouvrir la
# console Plateforme (tous les espaces, changement de formule).
PLATFORM_ADMINS="patron@mondomaine.com"
