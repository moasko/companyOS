// Schéma CompanyOS — PostgreSQL.
//
// Modèle multi-tenant : un Tenant = un espace de travail (une entreprise).
// Chaque table métier porte un tenantId, c'est la frontière d'isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Invitation à rejoindre un espace de travail.
///
/// Pas d'e-mail à envoyer : l'invitation produit un code que l'inviteur
/// transmet comme il l'entend. Voir la migration 20260806120000_invitations
/// pour le raisonnement.
model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  role        Role      @default(MEMBER)
  code        String    @unique
  createdById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Une seule invitation en attente par adresse : l'index d'unicité est
  /// partiel (`WHERE acceptedAt IS NULL`), donc créé à la main dans la
  /// migration. Ne pas ajouter de `@@unique` ici.
  @@index([tenantId])
  @@map("invitations")
}

/// Journal d'activité : qui a fait quoi, quand, sur quoi.
///
/// Une ligne est écrite pour toute action qui change quelque chose
/// d'important — membres, rôles, applications, fichiers, espace. Les
/// lectures ne sont pas journalisées : elles noieraient le reste.
///
/// Le journal est en écriture seule. Aucune route ne le modifie ni ne le
/// supprime : un journal qu'on peut nettoyer ne prouve rien.
model AuditEvent {
  id        String   @id @default(cuid())
  tenantId  String
  /// Auteur. Conservé même si le compte est supprimé — d'où le nom et
  /// l'adresse recopiés ici plutôt qu'une relation : « membre retiré par
  /// un compte qui n'existe plus » n'aiderait personne.
  userId    String?
  userName  String
  userEmail String
  /// Verbe technique, ex. "membre.role", "fichier.corbeille", "app.install".
  action    String
  /// Ce sur quoi l'action porte, tel qu'on l'affiche : un nom de fichier,
  /// une adresse e-mail, un nom d'application.
  cible     String?
  /// Contexte utile à la relecture : ancien et nouveau rôle, taille,
  /// dossier parent… Volontairement libre.
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("audit_events")
}

/// Notification interne, adressée à une personne de l'espace.
///
/// Volontairement générique : n'importe quelle application en envoie une
/// sans que le serveur connaisse son métier. « Awa vous a attribué une
/// tâche », « la facture 042 est réglée », « votre quota est à 90 % » sont
/// la même chose vue d'ici.
model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  /// Destinataire. Toujours renseigné : une notification sans personne à
  /// qui parler n'a pas lieu d'exister.
  userId    String
  /// Auteur. Vide pour ce qu'émet le système lui-même.
  auteurId  String?
  auteurNom String?
  /// Module émetteur, ex. "projets" — sert à filtrer et à choisir l'icône.
  source    String
  titre     String
  message   String?
  /// Où aller quand on clique : { app: "projets", params: { carte: "…" } }.
  /// Le shell sait ouvrir une app par son identifiant ; le reste est libre
  /// et relu par l'application elle-même.
  lien      Json?
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// L'écran ne demande jamais que « mes notifications, les plus récentes
  /// d'abord », et « combien de non lues ».
  @@index([userId, createdAt])
  @@index([userId, lu])
  @@map("notifications")
}

enum NodeType {
  FOLDER
  FILE
}

enum AppKind {
  NATIVE // module livré dans le shell CompanyOS
  IFRAME // outil externe intégré dans une fenêtre
  CUSTOM // application décrite depuis le Studio, exécutée par un moteur générique
}

/// Un espace de travail. Créé à l'inscription, porte le quota et l'abonnement.
model Tenant {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  plan            Plan      @default(FREE)
  /// Quota de stockage alloué, en octets.
  quota           BigInt
  /// Octets réellement consommés. Tenu à jour dans la même transaction
  /// que la création / suppression de fichiers.
  usedBytes       BigInt    @default(0)
  /// Où atterrissent les fichiers de cet espace.
  ///
  /// « plateforme » — là où l'exploitant a décidé, c'est-à-dire le cas de
  /// tout le monde par défaut. « s3 » — le stockage objet de l'entreprise
  /// elle-même : son compte Amazon, son Cloudflare R2, ou le NAS de ses
  /// bureaux sous MinIO. Une entreprise qui l'exige peut ainsi garder ses
  /// documents chez elle sans quitter le service.
  stockage        String    @default("plateforme")
  /// La configuration correspondante. La clé secrète y est chiffrée, comme
  /// celle de la plateforme — elle ne ressort jamais en clair.
  stockageS3      Json?
  /// Espace suspendu : ses membres ne peuvent plus se connecter ni agir.
  ///
  /// C'est le seul levier de l'exploitant face à un client qui ne paie plus
  /// ou qui abuse du service — un envoi de courrier en masse, par exemple,
  /// où c'est la réputation de l'IP de la plateforme qui est en jeu.
  ///
  /// **Rien n'est supprimé.** Les données restent intactes et reviennent
  /// telles quelles à la levée : une suspension est une porte fermée, pas
  /// un effacement. C'est ce qui la rend utilisable sans crainte — on peut
  /// suspendre d'abord et discuter ensuite.
  suspendu        Boolean   @default(false)
  suspenduLe      DateTime?
  /// Montré à l'utilisateur qui tente de se connecter : « suspendu » sans
  /// motif transforme un litige commercial en incident technique, et fait
  /// perdre du temps aux deux parties.
  motifSuspension String?
  /// Double authentification exigée de tous les membres de l'espace.
  mfaObligatoire  Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users         User[]
  nodes         FsNode[]
  installations Installation[]
  records       Record[]
  apps          App[]
  invitations   Invitation[]
  auditEvents   AuditEvent[]
  notifications Notification[]
  mailCompteurs MailCompteur[]

  @@map("tenants")
}

model User {
  id             String   @id @default(cuid())
  tenantId       String
  email          String   @unique
  passwordHash   String
  name           String
  role           Role     @default(MEMBER)
  /// Photo de profil, en data URL (image/jpeg redimensionnée à 256 px par le
  /// navigateur avant l'envoi, ~20 Ko). Stockée ici plutôt que dans le
  /// stockage objet parce qu'elle est lue partout, en liste, et qu'une
  /// balise <img> ne sait pas présenter un jeton d'authentification.
  /// Vide = avatar aux initiales, calculé à l'affichage.
  avatar         String?
  /// État personnel du shell synchronisé entre les appareils : disposition
  /// du bureau, fenêtres, thème et préférences régionales. Jamais de secret.
  preferences    Json     @default("{}")
  /// Version des sessions, recopiée dans chaque jeton. L'incrémenter
  /// déconnecte d'un coup tous les appareils du compte — voir `signToken`.
  sessionVersion Int      @default(0)
  /// Double authentification (TOTP, RFC 6238). Le secret est chiffré
  /// (voir src/chiffrement.js) ; il n'est actif qu'une fois un premier code
  /// validé — un secret généré mais jamais confirmé ne verrouille personne.
  totpSecret     String?
  totpActif      Boolean  @default(false)
  /// Dernier pas de 30 s accepté : un code déjà servi ne sert pas deux fois.
  totpDernierPas Int?
  /// Codes de secours, à usage unique : leurs empreintes SHA-256 seulement.
  codesSecours   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nodes         FsNode[]
  installations Installation[]
  notifications Notification[]
  sessions      Session[]

  @@index([tenantId])
  @@map("users")
}

/// Catalogue des applications proposées dans la Boutique.
///
/// `tenantId` null = application du catalogue global, offerte à tous.
/// `tenantId` renseigné = application créée dans le Studio par cet espace de
/// travail : elle n'apparaît que dans sa Boutique, jamais chez les autres.
model App {
  id          String   @id @default(cuid())
  tenantId    String?
  slug        String
  name        String
  description String
  /// Nom de l'icône dans public/img/icon, ou URL absolue.
  icon        String
  category    String
  version     String   @default("1.0.0")
  kind        AppKind  @default(NATIVE)
  /// URL chargée dans la fenêtre pour les apps IFRAME.
  url         String?
  /// Description déclarative des applications CUSTOM : collections et champs.
  /// Le moteur générique du shell en déduit listes, formulaires et CRUD.
  definition  Json?
  /// Une app non publiée reste visible dans le Studio, pas dans la Boutique.
  published   Boolean  @default(true)
  /// Une app "core" est présente d'office et ne peut pas être désinstallée.
  isCore      Boolean  @default(false)
  publishedAt DateTime @default(now())

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installations Installation[]

  /// Deux espaces de travail peuvent utiliser le même slug sans se gêner ;
  /// à l'intérieur d'un espace, il reste unique.
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("apps")
}

/// Une app installée dans un espace de travail par un utilisateur.
model Installation {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  appId       String
  /// Réglages propres à cette installation (clés API, préférences…).
  settings    Json     @default("{}")
  /// Version de l'application au moment de l'installation ou de la dernière
  /// mise à jour. C'est elle, comparée à la version livrée par le shell,
  /// qui fait apparaître « mise à jour disponible » dans la Boutique.
  ///
  /// Vide pour les installations antérieures à ce champ : elles seront
  /// simplement présentées comme à mettre à jour, ce qui est exact.
  version     String?
  /// Qui peut ouvrir l'application dans cet espace :
  /// `{ mode: "membres" | "admins" | "selection", membres?: [userId] }`.
  /// Vide = la règle par défaut de l'application (voir src/acces.js) —
  /// la Paie et les RH sont réservées aux administrateurs, le reste est
  /// ouvert à tous.
  acces       Json?
  installedAt DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  /// Une app n'est installée qu'une fois par espace de travail.
  @@unique([tenantId, appId])
  @@index([tenantId])
  @@map("installations")
}

/// Données génériques des modules métier. Chaque app range ses
/// enregistrements dans (module, collection) — ex. ("crm", "clients") —
/// avec un document JSONB libre. Une nouvelle app n'exige donc aucune
/// migration : elle choisit son couple module/collection et écrit.
/// Quand un module mûrit, on le sort vers de vraies tables typées.
model Record {
  id          String   @id @default(cuid())
  tenantId    String
  /// Qui a saisi la fiche. Ne change jamais.
  userId      String
  /// Qui l'a touchée en dernier. Sans cela, « saisi par Awa » reste vrai
  /// des mois après que quelqu'un d'autre a tout réécrit.
  updatedById String?
  module      String
  collection  String
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, module, collection])
  @@map("records")
}

/// Arborescence de fichiers. Les octets vivent dans le stockage objet,
/// cette table ne porte que les métadonnées et la clé de stockage.
model FsNode {
  id         String    @id @default(cuid())
  tenantId   String
  ownerId    String
  parentId   String?
  name       String
  type       NodeType
  /// Taille en octets. 0 pour un dossier.
  size       BigInt    @default(0)
  mimeType   String?
  /// Clé dans le stockage objet. null pour un dossier.
  storageKey String?
  /// **Où** vivent les octets : « local », « s3 »…
  ///
  /// C'est ce champ qui rend le changement de destination sans danger.
  /// L'exploitant bascule le SaaS vers S3 : les nouveaux fichiers y vont,
  /// les anciens restent sur le disque et continuent d'être lus là-bas.
  /// Aucune migration à mener, aucun fichier à perdre — et revenir en
  /// arrière est tout aussi anodin.
  storage    String    @default("local")
  /// Mise à la corbeille. null = élément vivant. Les octets restent
  /// stockés et comptés dans le quota tant que la corbeille n'est pas vidée.
  deletedAt  DateTime?
  /// Id de l'élément qui a été supprimé — le même pour tout un sous-arbre
  /// mis à la corbeille d'un coup. La corbeille n'affiche que les entrées
  /// où `trashId = id`, et restaurer l'une d'elles restaure le groupe entier.
  trashId    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent   FsNode?  @relation("FsNodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children FsNode[] @relation("FsNodeChildren")

  /// Deux entrées vivantes ne peuvent pas porter le même nom dans le même
  /// dossier — mais un élément à la corbeille ne doit pas réserver son nom.
  /// C'est un index unique *partiel* (`WHERE deleted_at IS NULL`), que
  /// Prisma ne sait pas décrire : il est créé à la main dans la migration
  /// `20260806040000_corbeille`. Ne pas remettre `@@unique` ici.
  @@index([tenantId, parentId])
  @@index([tenantId, trashId])
  @@map("fs_nodes")
}

/// Compteur d'envois de courriels, par espace et par jour.
///
/// ─────────────────────────────────────────────────────────────────────────
/// POURQUOI
///
/// Trois chemins font partir un courriel : l'app Courrier (envoi manuel),
/// le moteur de campagnes, et les relances de factures. Tous les trois
/// finissent sur le même relais SMTP, avec le nom de l'entreprise en
/// expéditeur et la réputation SPF/DKIM du domaine en garantie.
///
/// Sans compteur, un seul compte membre — ou un jeton volé — suffit à
/// transformer la plateforme en relais de spam : le temps qu'on s'en
/// aperçoive, l'IP d'envoi est sur liste noire et **tous** les espaces ne
/// reçoivent plus leurs factures. Le plafond est volontairement commun aux
/// trois chemins : le compter par chemin laisserait additionner les trois.
///
/// Une ligne par espace et par jour, purgée au-delà de 90 jours par la
/// tâche de fond. Le compteur sert aussi de piste : un pic est visible.
/// ─────────────────────────────────────────────────────────────────────────
model MailCompteur {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  /// Le jour au format AAAA-MM-JJ, en UTC. Une chaîne et pas une date :
  /// c'est une clé de regroupement, et la comparer ne doit pas dépendre du
  /// fuseau du serveur.
  jour String

  /// Nombre de messages **effectivement remis au relais** — un envoi en
  /// échec ne consomme pas le quota, sans quoi un relais mal configuré
  /// épuiserait le plafond sans qu'un seul message parte.
  envoyes Int @default(0)

  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, jour])
  @@map("mail_compteurs")
}

/// Réglages de la plateforme elle-même, au-dessus des espaces de travail.
///
/// Une seule ligne, d'identifiant « global » : ce ne sont pas les réglages
/// d'un client mais ceux de l'exploitant du SaaS. Seule la console
/// Plateforme y touche (voir src/routes/plateforme.js).
model PlatformConfig {
  id String @id @default("global")

  /// Destination des **nouveaux** fichiers : « local » ou « s3 ».
  /// Les fichiers déjà écrits gardent la leur (FsNode.storage).
  stockage String @default("local")

  /// Configuration du stockage objet. La clé secrète y est **chiffrée**
  /// (AES-256-GCM, voir src/chiffrement.js) : une copie de la base ne doit
  /// pas donner accès aux fichiers de tous les clients.
  s3 Json?

  updatedAt DateTime @updatedAt

  @@map("platform_config")
}

/// Une sauvegarde de la base, réussie ou non.
///
/// Garder les échecs est le but : une sauvegarde qui échoue en silence
/// depuis trois semaines ne se découvre que le jour où l'on en a besoin.
/// La console de l'exploitant lit cette table pour dire, d'un coup d'œil,
/// depuis quand la plateforme n'a pas été sauvegardée.
model Sauvegarde {
  id          String    @id @default(cuid())
  /// « base » (pg_dump de toute la base) ou « fichiers » (archive du
  /// stockage local).
  type        String
  /// « auto » (moteur planifié) ou « manuelle » (bouton de la console).
  declencheur String
  /// « en_cours », « ok » ou « echec ».
  statut      String    @default("en_cours")
  fichier     String?
  octets      BigInt?
  /// Empreinte SHA-256 du fichier : de quoi vérifier une copie rapatriée.
  sha256      String?
  /// L'archive a été relue avec succès (`pg_restore --list`).
  verifiee    Boolean   @default(false)
  /// Copie envoyée hors du serveur, sur le stockage objet de la plateforme.
  horsSite    Boolean   @default(false)
  erreur      String?
  debut       DateTime  @default(now())
  fin         DateTime?

  @@index([type, debut])
  @@map("sauvegardes")
}

/// Une erreur rencontrée par l'API ou par le navigateur d'un utilisateur.
///
/// Les occurrences d'une même erreur sont regroupées par leur empreinte
/// (source, message, premier cadre de la pile) : mille utilisateurs qui
/// tombent sur le même bogue font une ligne et un compteur, pas mille
/// lignes. Pas de clé étrangère vers l'espace ni le compte : le journal
/// doit survivre à leur suppression.
model ErreurApp {
  id          String   @id @default(cuid())
  empreinte   String   @unique
  /// « api » ou « web ».
  source      String
  message     String
  pile        String?
  /// Route de l'API, ou adresse de la page côté navigateur.
  url         String?
  occurrences Int      @default(1)
  /// Le dernier espace et le dernier compte touchés, pour reproduire.
  tenantId    String?
  userId      String?
  details     Json?
  resolue     Boolean  @default(false)
  premiere    DateTime @default(now())
  derniere    DateTime @default(now())

  @@index([resolue, derniere])
  @@map("erreurs")
}

/// Une session ouverte : un navigateur connecté, ou un jeton d'API (le
/// serveur MCP, par exemple).
///
/// Le jeton signé porte l'identifiant de la session (`sid`) ; chaque
/// requête la relit. Fermer une session — déconnexion, appareil perdu,
/// intervention d'un administrateur — prend donc effet à la requête
/// suivante, appareil par appareil, au lieu d'attendre l'expiration du
/// jeton.
model Session {
  id        String    @id @default(cuid())
  userId    String
  /// « navigateur » (cookie HttpOnly) ou « api » (jeton porté par un
  /// outil). Une session d'API n'expire pas par inactivité.
  type      String    @default("navigateur")
  libelle   String?
  ip        String?
  agent     String?
  /// Ouverte avec un second facteur.
  mfa       Boolean   @default(false)
  creeLe    DateTime  @default(now())
  vuLe      DateTime  @default(now())
  expireLe  DateTime
  revoqueLe DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
